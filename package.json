{
  "name": "square_campus_marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "bun run check:claims && bun run check:content && next build",
    "check:claims": "bash scripts/check-claims.sh",
    "check:content": "bun scripts/check-content.ts",
    "gen:hero": "bun scripts/hero-workflow-screen.ts",
    "preview": "bunx serve out",
    "deploy": "./scripts/deploy.sh",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "check-types": "tsc --noEmit",
    "motion:studio": "cd motion && bun install && bun run studio",
    "motion:render": "cd motion && bun install && bun run render"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "postcss": "^8.5.23",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.19"
  }
}
