{
  "name": "square_campus_marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "bun run check:claims && bun run check:content && next build && bun run build:markdown && bun run check:build",
    "build:markdown": "bun scripts/markdown-alternates.ts",
    "check:claims": "bash scripts/check-claims.sh",
    "check:content": "bun scripts/check-content.ts",
    "check:build": "bun scripts/check-build.ts",
    "test": "bun tests/run.ts",
    "gen:hero": "bun scripts/hero-workflow-screen.ts",
    "preview": "bunx serve out",
    "deploy": "./scripts/deploy.sh",
    "indexnow:dry-run": "bun scripts/indexnow.ts --dry-run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "check-types": "tsc --noEmit",
    "motion:studio": "cd motion && bun install && bun run studio",
    "motion:render": "cd motion && bun install && bun run render"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "^8.5.19"
  }
}
