{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SubmissionTableWrite",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem"],
      "Resource": "arn:aws:dynamodb:ap-south-1:ACCOUNT_ID:table/squarecampus-contact-requests"
    },
    {
      "Sid": "M365SecretRead",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:m365/graph-mailer-*"
    },
    {
      "Sid": "CrmBridgeSecretRead",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": "arn:aws:secretsmanager:ap-south-1:ACCOUNT_ID:secret:squarecampus/contact-crm-bridge-*"
    },
    {
      "Sid": "CrmRetryEnqueue",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": "arn:aws:sqs:ap-south-1:ACCOUNT_ID:squarecampus-contact-crm-retry"
    }
  ]
}
